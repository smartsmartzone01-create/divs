DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam

# Set true to use PostgreSQL instead of the default local SQLite database.
DIVS_USE_POSTGRESQL=false
POSTGRES_DB=divs
POSTGRES_USER=divs
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional for local development; production should use a shared Redis instance for throttles.
REDIS_URL=

# Google Identity Services client ID used to validate Google ID tokens.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=

# SMTP settings for email verification delivery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

# SMS provider integration is not wired yet.
SMS_OTP_PROVIDER=
