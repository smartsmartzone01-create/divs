DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam

# Set PostgreSQL environment variables when using PostgreSQL.
POSTGRES_DB=divs
POSTGRES_USER=divs
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Configure later when Google OIDC is implemented.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=

# Configure later when email/SMS verification providers are selected.
EMAIL_VERIFICATION_PROVIDER=
SMS_OTP_PROVIDER=
